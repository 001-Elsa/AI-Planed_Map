DATABASE_URL=sqlite+aiosqlite:///./data/mapgo-python.db
AMAP_WEB_KEY=your_web_service_key
AMAP_KEY=your_web_js_api_key
AMAP_JSCODE=your_web_js_api_security_jscode
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
MAX_LLM_OUTPUT_TOKENS=2000
PROMPT_VERSION=intent-v2
ADMIN_INIT_TOKEN=change_this_before_production
EXTERNAL_TIMEOUT_SECONDS=8
EXTERNAL_CONNECT_TIMEOUT_SECONDS=2
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
MAP_MAX_CONCURRENCY=8
UPSTREAM_MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
MAX_ROUTE_MATRIX_POINTS=25
IDEMPOTENCY_TTL_SECONDS=86400
MOCK_MAP_PROVIDER=false
MOCK_WEATHER_PROVIDER=true
REDIS_URL=
API_REQUESTS_PER_MINUTE=120
AI_PLANS_PER_DAY=50
DAILY_AI_TOKEN_QUOTA=100000
MAX_AI_REQUEST_COST_USD=0.20
MAX_AGENT_TOOL_CALLS=8
MAX_REPLANS_PER_TRIP=10
PRECISE_LOCATION_TTL_MINUTES=120
LOCATION_ENCRYPTION_KEY=replace-with-secret-manager-value-in-production
FEATURE_COMPANION_AGENT=true
