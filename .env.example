DATABASE_URL=sqlite+aiosqlite:///./data/mapgo-python.db
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
AMAP_WEB_KEY=your_web_service_key
AMAP_KEY=your_web_js_api_key
AMAP_JSCODE=your_web_js_api_security_jscode
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_SMALL_MODEL=gpt-4.1-mini
LLM_STRONG_MODEL=gpt-4.1
# Evaluation-only provenance labels. They never contain credentials.
AGENT_EVAL_PROVIDER=openai-compatible
AGENT_EVAL_MODEL_VERSION=
AGENT_EVAL_OUTPUT_DIR=artifacts/agent-evaluation
MODEL_ROUTER_ENABLED=true
MODEL_ROUTER_RULE_MAX_COMPLEXITY=1
MODEL_ROUTER_STRONG_MIN_COMPLEXITY=5
MODEL_ROUTER_STRONG_MIN_UNCERTAINTY=2
LLM_SMALL_INPUT_COST_PER_MILLION_USD=0.40
LLM_SMALL_OUTPUT_COST_PER_MILLION_USD=1.60
LLM_STRONG_INPUT_COST_PER_MILLION_USD=2.00
LLM_STRONG_OUTPUT_COST_PER_MILLION_USD=8.00
MAX_LLM_OUTPUT_TOKENS=2000
PROMPT_VERSION=intent-v2
ADMIN_INIT_TOKEN=
EXTERNAL_TIMEOUT_SECONDS=8
EXTERNAL_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
MAP_MAX_CONCURRENCY=8
UPSTREAM_MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
MAX_ROUTE_MATRIX_POINTS=25
IDEMPOTENCY_TTL_SECONDS=86400
MOCK_MAP_PROVIDER=false
MOCK_WEATHER_PROVIDER=true
# Test/emergency switch: ignore map credentials from this file until an admin saves runtime keys.
DISABLE_CONFIGURED_MAP_CREDENTIALS=false
REDIS_URL=
REQUIRED_SCHEMA_REVISION=0016
MULTI_AGENT_ENABLED=true
# off | shadow | enforce
PLAN_CRITIC_MODE=shadow
MAX_AGENT_WORKFLOW_COST_USD=0.08
MAX_AGENT_HANDOFFS=12
AGENT_STAGE_TIMEOUT_SECONDS=12
AGENT_SEARCH_MAX_ATTEMPTS=2
AGENT_SHARED_STATE_TTL_SECONDS=7200
AGENT_SHARED_STATE_MAX_HISTORY=100
AGENT_SHARED_STATE_MAX_BYTES=512000
MAX_CRITIC_INPUT_TOKENS=4000
MAX_CRITIC_OUTPUT_TOKENS=800
MAX_CRITIC_RETRIES=1
CRITIC_ENFORCE_MIN_SHADOW_SAMPLES=30
CRITIC_ENFORCE_MAX_FALLBACK_RATE=0.02
CRITIC_ENFORCE_MAX_BLOCKING_RATE=0.05
CRITIC_ENFORCE_MAX_BUDGET_EXCEEDED_RATE=0.01
CRITIC_ENFORCE_MAX_P95_LATENCY_MS=5000
WORKER_RECOVER_PROCESSING_LIMIT=100
WORKER_LOCK_TTL_SECONDS=30
WORKER_LOCK_RENEW_INTERVAL_SECONDS=10
MAX_REQUEST_BYTES=1000000
API_REQUESTS_PER_MINUTE=120
API_IP_REQUESTS_PER_MINUTE=3000
# Legacy setting name; this budget is now keyed by auth source IP, not device headers.
AUTH_DEVICE_REQUESTS_PER_MINUTE=30
AUTH_IP_REQUESTS_PER_MINUTE=600
AMAP_PROXY_REQUESTS_PER_MINUTE=300
AMAP_PROXY_MAX_RESPONSE_BYTES=2000000
AMAP_PROXY_MAX_CACHE_BYTES=250000
AI_PLANS_PER_DAY=50
DAILY_AI_TOKEN_QUOTA=100000
MAX_AI_REQUEST_COST_USD=0.20
MAX_AGENT_TOOL_CALLS=8
MAX_AGENT_TOOL_CALLS_PER_RUN=4
MAX_AGENT_TOOL_CALLS_PER_TASK=8
MAX_AGENT_TOOL_CALLS_PER_TRIP=40
MAX_AGENT_STEPS=4
MAX_AGENT_INPUT_TOKENS=6000
MAX_AGENT_OUTPUT_TOKENS=800
MAX_AGENT_RUN_COST_USD=0.05
MAX_REPLANS_PER_TRIP=10
PRECISE_LOCATION_TTL_MINUTES=120
LOCATION_ENCRYPTION_KEY=
FEATURE_COMPANION_AGENT=true
AGENT_MESSAGE_TRANSPORT=auto
# sync keeps role execution in the workflow owner; distributed requires Redis Streams
# and the background Replanner AgentTaskWorker.
AGENT_EXECUTION_MODE=sync
AGENT_STREAM_PREFIX=mapgo:agent-messages
AGENT_CONSUMER_GROUP_PREFIX=mapgo:agent-workers
AGENT_STREAM_MAX_LENGTH=20000
AGENT_MESSAGE_MAX_ATTEMPTS=3
AGENT_MESSAGE_RECLAIM_IDLE_MS=30000
# Optional late-bound MCP integration. Disabled by default; external endpoints
# and tool allowlists are operator configuration, never model arguments.
MCP_SERVER_ENABLED=false
MCP_INTERNAL_TOKEN=
MCP_ALLOWED_ORIGINS=
MCP_SERVERS_JSON=
MCP_TIMEOUT_SECONDS=8
MCP_MAX_RESPONSE_BYTES=512000
MCP_REQUESTS_PER_MINUTE=120
