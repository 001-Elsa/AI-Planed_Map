{
  "dataset_id": "mapgo-agent-golden",
  "version": "1.0.0",
  "description": "Versioned planning, orchestration, recovery, critic and HITL evaluation cases. Templates expand deterministically to 180 cases.",
  "templates": [
    {"id":"standard_route","variants":8,"scenario":"standard","text":"Plan a driving route from West Lake to museum-{variant}, park-{variant}, and cafe-{variant} tomorrow at 09:00.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"]},
    {"id":"incomplete_requirement","variants":8,"scenario":"clarification","text":"I want to visit museum-{variant} and park-{variant}, but I have not provided my starting point.","expected_statuses":["need_clarification"],"expected_tools":["parse_requirement"],"clarification_expected":true},
    {"id":"multi_turn_clarification","variants":8,"scenario":"clarification","text":"Continue planning museum-{variant} after my earlier answer; ask if any required origin is still missing.","expected_statuses":["need_clarification"],"expected_tools":["parse_requirement"],"clarification_expected":true},
    {"id":"budget_conflict","variants":8,"scenario":"infeasible","text":"Visit premium-attraction-{variant} and restaurant-{variant} within an impossible total budget.","expected_statuses":["infeasible","need_clarification"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"hard_constraint_expected":true},
    {"id":"time_window_conflict","variants":8,"scenario":"infeasible","text":"Leave at 09:00 but arrive at museum-{variant} before 08:55.","expected_statuses":["infeasible","need_clarification"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"hard_constraint_expected":true},
    {"id":"place_closed","variants":8,"scenario":"poi_closed","text":"The selected park-{variant} has just closed; safely replan to an available alternative.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"replan_expected":true,"recovery_expected":true},
    {"id":"provider_low_quality","variants":8,"scenario":"critic_bad_evidence","text":"Plan museum-{variant} with provider results whose provenance is incomplete.","expected_statuses":["need_clarification"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"critic_bad_plan_expected":true},
    {"id":"high_walking_distance","variants":8,"scenario":"safety","text":"Plan a relaxed day for an elderly traveller at museum-{variant}; minimize walking.","expected_statuses":["success","need_clarification"],"expected_tools":["parse_requirement","search_poi","check_travel_safety","get_route_matrix","optimize_route"],"hitl_expected":true},
    {"id":"elderly_party","variants":8,"scenario":"safety","text":"Plan museum-{variant} and park-{variant} for one adult and one elderly traveller with low walking.","expected_statuses":["success","need_clarification"],"expected_tools":["parse_requirement","search_poi","check_travel_safety","get_route_matrix","optimize_route"],"hitl_expected":true},
    {"id":"children_party","variants":8,"scenario":"safety","text":"Plan museum-{variant} and family-park-{variant} for adults with a young child.","expected_statuses":["success","need_clarification"],"expected_tools":["parse_requirement","search_poi","check_travel_safety","get_route_matrix","optimize_route"],"hitl_expected":true},
    {"id":"dietary_restriction","variants":8,"scenario":"standard","text":"Plan museum-{variant} then a restaurant with a strict vegetarian dietary restriction.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"]},
    {"id":"user_route_change","variants":8,"scenario":"off_route","text":"Replace park-{variant} with indoor-museum-{variant} after the route was confirmed.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"replan_expected":true,"recovery_expected":true},
    {"id":"weather_change","variants":7,"scenario":"weather_change","text":"Heavy rain started; replace outdoor-park-{variant} with an indoor place and replan.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"replan_expected":true,"recovery_expected":true},
    {"id":"route_deviation","variants":7,"scenario":"off_route","text":"The traveller deviated from route-{variant}; replan from the new position.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"replan_expected":true,"recovery_expected":true},
    {"id":"tool_failure","variants":7,"scenario":"search_recovery","text":"Plan museum-{variant} while POI search fails once and then recovers.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"recovery_expected":true},
    {"id":"tool_timeout","variants":7,"scenario":"matrix_failure","text":"Plan museum-{variant} while the route matrix provider times out.","expected_statuses":["need_clarification"],"expected_tools":["parse_requirement","search_poi","get_route_matrix"],"clarification_expected":true,"recovery_expected":true},
    {"id":"llm_illegal_json","variants":7,"scenario":"clarification","text":"Return a safe planning response for malformed-model-output probe {variant}; do not invent a missing origin.","expected_statuses":["need_clarification"],"expected_tools":["parse_requirement"],"clarification_expected":true,"llm_fault_probe":"invalid_json"},
    {"id":"llm_hallucination","variants":7,"scenario":"critic_bad_evidence","text":"Do not trust or invent evidence for unknown-place-{variant}; require traceable provider data.","expected_statuses":["need_clarification"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"critic_bad_plan_expected":true,"llm_fault_probe":"hallucination"},
    {"id":"critic_false_reject","variants":7,"scenario":"standard","text":"Review a feasible ordinary route to museum-{variant} without rejecting it unnecessarily.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"critic_bad_plan_expected":false},
    {"id":"planner_infeasible","variants":7,"scenario":"infeasible","text":"Detect that museum-{variant} cannot be reached before its hard deadline.","expected_statuses":["infeasible","need_clarification"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"hard_constraint_expected":true},
    {"id":"hitl_required","variants":7,"scenario":"safety","text":"Plan a high-walking route for an elderly user and request human confirmation when risk remains.","expected_statuses":["need_clarification","success"],"expected_tools":["parse_requirement","search_poi","check_travel_safety","get_route_matrix","optimize_route"],"hitl_expected":true},
    {"id":"hitl_not_required","variants":7,"scenario":"standard","text":"Plan a normal low-risk route to museum-{variant}; no human approval should be required.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"hitl_expected":false},
    {"id":"replan_required","variants":7,"scenario":"poi_closed","text":"POI-{variant} closed after confirmation; replan exactly once.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"replan_expected":true,"recovery_expected":true},
    {"id":"replan_not_required","variants":7,"scenario":"standard","text":"The confirmed route to museum-{variant} is unchanged; do not replan.","expected_statuses":["success"],"expected_tools":["parse_requirement","search_poi","get_route_matrix","optimize_route"],"replan_expected":false}
  ]
}
